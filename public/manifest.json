{
  "name": "Daily Khata Pro",
  "short_name": "Daily Khata Pro",
  "description": "Daily Khata Pro — Universal professional daily income & expense tracker with automated 6-fund money allocation, financial goals, work deliverables, and ledger statements.",
  "start_url": "/",
  "scope": "/",
  "id": "com.rozfiber.dailykhatapro",
  "display": "standalone",
  "display_override": ["tabbed", "standalone", "window-controls-overlay", "minimal-ui", "browser"],
  "tab_strip": {
    "home_tab": {
      "scope": "/"
    },
    "new_tab_button": {
      "url": "/add"
    }
  },
  "note_taking": {
    "new_note_url": "/add"
  },
  "background_color": "#070E18",
  "theme_color": "#070E18",
  "orientation": "portrait-primary",
  "dir": "ltr",
  "lang": "en-IN",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.rozfiber.dailykhatapro",
      "id": "com.rozfiber.dailykhatapro"
    },
    {
      "platform": "windows",
      "url": "https://www.rozfiber.com",
      "id": "com.rozfiber.dailykhatapro"
    },
    {
      "platform": "webapp",
      "url": "https://www.rozfiber.com/manifest.json",
      "id": "com.rozfiber.dailykhatapro"
    }
  ],
  "scope_extensions": [
    { "origin": "https://www.rozfiber.com" },
    { "origin": "https://rozfiber.com" },
    { "origin": "https://*.rozfiber.com" },
    { "origin": "https://app.rozfiber.com" }
  ],
  "categories": ["finance", "productivity", "utilities", "business"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "share_target": {
    "action": "/add",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/history",
      "name": "Daily Khata Ledger Data",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+khata",
      "url": "/add?entry=%s"
    }
  ],
  "widgets": [
    {
      "name": "Daily Khata Balance",
      "description": "Quick view of your daily net balance and 6-fund allocations",
      "tag": "daily-balance",
      "template": "widget-balance",
      "ms_ac_template": "widgets/balance.json",
      "data": "widgets/balance-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/screenshot-mobile.png",
          "sizes": "720x1280",
          "label": "Daily Balance Widget Preview"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/daily-Khata-Pro.png",
      "sizes": "1254x1254",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Transaction",
      "short_name": "Add Entry",
      "description": "Log new income or expense entry",
      "url": "/add",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Passbook & Ledger",
      "short_name": "Ledger",
      "description": "View transaction history & ledger statements",
      "url": "/history",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Financial Goals",
      "short_name": "Goals",
      "description": "Track savings targets & milestones",
      "url": "/goals",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Help & Support",
      "short_name": "Support",
      "description": "Report bugs & get help",
      "url": "/support",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Daily Khata Pro Dashboard — 6-Fund Wealth Rule, Net Balance & Ledger"
    },
    {
      "src": "/screenshots/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Daily Khata Pro Mobile — Instant Income & Expense Tracking"
    }
  ]
}
